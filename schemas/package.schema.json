{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arch-setup/schemas/package.schema.json",
  "title": "Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "description", "url", "source", "repository"],
  "properties": {
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "url": { "type": ["string", "null"], "pattern": "^https://" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": ["string", "null"], "pattern": "^https://" },
        "release_asset": { "type": "string" },
        "release_asset_pattern": { "type": "string", "format": "regex" }
      },
      "not": { "required": ["release_asset", "release_asset_pattern"] }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https://archlinux\\.org/packages/(core|extra|multilib)/(x86_64|any)/[^/]+/$"
            },
            {
              "type": "string",
              "pattern": "^https://aur\\.archlinux\\.org/packages/[^/]+$"
            },
            { "type": "null" }
          ]
        },
        "optional_dependency_for": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "reason"],
            "properties": {
              "package": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "source": {
        "anyOf": [{ "required": ["release_asset"] }, { "required": ["release_asset_pattern"] }]
      }
    }
  },
  "then": {
    "properties": {
      "source": { "properties": { "url": { "type": "string", "pattern": "^https://github\\.com/" } } },
      "repository": { "properties": { "url": { "type": "null" } } }
    }
  }
}
