{
  "app_config": {
    "audio_config": {
      "audio": "pipewire"
    }
  },
  "archinstall-language": "English",
  "bootloader_config": {
    "bootloader": "Grub",
    "removable": true,
    "uki": false
  },
  "custom_commands": [],
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/sda",
        "partitions": [
          {
            "btrfs": [],
            "dev_path": null,
            "flags": ["boot", "esp"],
            "fs_type": "fat32",
            "mount_options": [],
            "mountpoint": "/boot",
            "obj_id": "efi",
            "size": {
              "sector_size": { "unit": "B", "value": 512 },
              "unit": "MiB",
              "value": 1024
            },
            "start": {
              "sector_size": { "unit": "B", "value": 512 },
              "unit": "MiB",
              "value": 1
            },
            "status": "create",
            "type": "primary"
          },
          {
            "btrfs": [
              { "mountpoint": "/", "name": "@" },
              { "mountpoint": "/home", "name": "@home" },
              { "mountpoint": "/var/cache/pacman/pkg", "name": "@pkg" },
              { "mountpoint": "/var/log", "name": "@log" }
            ],
            "dev_path": null,
            "flags": [],
            "fs_type": "btrfs",
            "mount_options": ["compress=zstd"],
            "mountpoint": null,
            "obj_id": "root",
            "size": {
              "sector_size": { "unit": "B", "value": 512 },
              "unit": "MiB",
              "value": 130046
            },
            "start": {
              "sector_size": { "unit": "B", "value": 512 },
              "unit": "MiB",
              "value": 1025
            },
            "status": "create",
            "type": "primary"
          }
        ],
        "wipe": true
      }
    ]
  },
  "hostname": "arch-vm",
  "kernels": ["linux", "linux-lts"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "mirror_config": {
    "custom_servers": [],
    "mirror_regions": {}
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": ["git", "linux-headers", "linux-lts-headers", "ntfsprogs", "virtualbox-guest-utils"],
  "pacman_config": {
    "color": true,
    "parallel_downloads": 5
  },
  "profile_config": {
    "gfx_driver": "VirtualBox (open-source)",
    "greeter": "sddm",
    "profile": {
      "details": ["KDE Plasma"],
      "main": "Desktop"
    }
  },
  "script": "guided",
  "services": ["vboxservice"],
  "swap": {
    "algorithm": "zstd",
    "enabled": true
  },
  "timezone": "Europe/Bucharest",
  "version": "4.5"
}
